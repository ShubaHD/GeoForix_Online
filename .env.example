# Local SQLite (dev only — switch schema provider to "sqlite" if you use this)
# DATABASE_URL="file:./dev.db"

# Local Docker Postgres (docker compose up -d) OR Neon / Vercel Postgres
DATABASE_URL="postgresql://geoforix:geoforix@localhost:5433/geoforix?schema=public"

# Required in production (Vercel)
AUTH_SECRET="change-me-to-a-long-random-string"

# Vercel Blob (photos / logo uploads in production)
# Create a Blob store in Vercel → Storage → Blob, then:
# BLOB_READ_WRITE_TOKEN=
